package myscanne.com;

/**
 * NativeScan - JNI bridge for the scan core (libspro.so).
 * TCP connect/port scan, TCP ping, DNS resolve and plain-HTTP probes run in
 * compiled ARM code. TLS-based probes stay on Java SSLSocket (no SSL in NDK).
 */
public class NativeScan {
    static {
        System.loadLibrary("spro");
    }
    /** Resolve host to dotted IPv4; "" on failure. */
    public static native String resolve(String host);
    /** TCP connect check - the port scan primitive. */
    public static native boolean tcpOpen(String host, int port, int timeoutMs);
    /** TCP ping; out = {avgMs, minMs, maxMs, received}; returns received count. */
    public static native int tcpPing(String host, int port, int count, int timeoutMs, long[] out);
    /** Plain HTTP HEAD on port 80; returns status code, 0 = fail. */
    public static native int httpCode(String host, String path, int timeoutMs);
}
